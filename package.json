{
  "name": "capybara-code",
  "version": "0.1.1-alpha.5",
  "private": true,
  "description": "Capybara Code (capy) - independent terminal coding agent powered by OpenAI models",
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*",
    "benchmarks/*"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test apps packages benchmarks/cbc-bench/test",
    "test:ts": "bun test packages apps benchmarks/cbc-bench/test",
    "test:rust": "cargo test --workspace",
    "test:perf": "bun test perf/harness.test.ts",
    "build:runtime": "bun run scripts/build-runtime.ts",
    "build:capy": "bun run scripts/build-standalone.ts --compile",
    "build": "bun run build:runtime && bun run build:capy",
    "stage": "bun run scripts/build-standalone.ts --development-launcher",
    "release:check": "bun run scripts/check-release.ts",
    "release:package": "bun run scripts/package-npm.ts",
    "release:archive": "bun run scripts/archive-release.ts",
    "release:smoke": "bun run scripts/smoke-release.ts",
    "release:checksums": "bun run scripts/write-release-checksums.ts",
    "test:release": "bun test scripts/release.test.ts",
    "dev:link": "bun run scripts/dev-link.ts link",
    "dev:unlink": "bun run scripts/dev-link.ts unlink",
    "legacy:cleanup": "powershell -ExecutionPolicy Bypass -File scripts/cleanup-legacy-capy.ps1",
    "legacy:cleanup:wsl": "bash scripts/cleanup-legacy-capy-wsl.sh",
    "verify": "bun run typecheck && bun run schemas:check && bun run runtime-boundary:check && bun run fixtures:check && bun run source-truth:check && bun run test:ts && bun run test:perf && bun run test:release && bun run test:rust",
    "schemas:check": "bun run scripts/check-protocol-drift.ts",
    "source-truth": "bun run scripts/source-truth.ts",
    "source-truth:check": "bun run scripts/source-truth.ts --check",
    "runtime-boundary:check": "bun run scripts/check-no-codex-runtime.ts",
    "fixtures": "bun run fixtures/generate.ts",
    "fixtures:check": "bun run fixtures/generate.ts --check",
    "bench": "bun run benchmarks/cbc-bench/src/cli.ts",
    "capy-dev": "bun run apps/cbc/src/main.ts"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "typescript": "5.9.3",
    "vite": "^8.2.1"
  },
  "trustedDependencies": [
    "@opentui/core"
  ],
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/core-linux-x64": "0.4.5",
    "@opentui/core-linux-x64-musl": "0.4.5"
  }
}
