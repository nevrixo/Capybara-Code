{
  "x-dialect": "json-schema-draft-2020-12",
  "$id": "cbc:plugin/manifest",
  "title": "PluginManifest",
  "description": "Isolated plugin package manifest. Matches packages/plugin-sdk/src/contracts.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "name",
    "version",
    "publisher",
    "description",
    "license",
    "runtime",
    "compatibility",
    "permissions",
    "integrity"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "publisher": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "license": { "type": "string", "minLength": 1 },
    "runtime": { "$ref": "#/$defs/runtime" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "hooks": {
      "type": "array",
      "items": { "$ref": "#/$defs/hookSubscription" }
    },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "commands": {
      "type": "array",
      "items": { "$ref": "#/$defs/command" }
    },
    "contextProviders": {
      "type": "array",
      "items": { "$ref": "#/$defs/contextProvider" }
    },
    "ui": { "$ref": "#/$defs/ui" },
    "permissions": { "$ref": "#/$defs/permissions" },
    "limits": { "$ref": "#/$defs/limits" },
    "integrity": { "$ref": "#/$defs/integrity" },
    "signature": { "$ref": "#/$defs/signature" }
  },
  "$defs": {
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entrypoint", "protocolVersion"],
      "properties": {
        "kind": { "type": "string", "enum": ["wasi", "stdio"] },
        "entrypoint": { "type": "string", "minLength": 1 },
        "protocolVersion": { "type": "string", "minLength": 1 }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capybara"],
      "properties": {
        "capybara": { "type": "string", "minLength": 1 },
        "platforms": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "hookSubscription": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "ordinal": { "type": "integer", "minimum": 0 },
        "critical": { "type": "boolean" }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "parametersSchema",
        "requestedRisk",
        "sideEffect",
        "network"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "parametersSchema": {},
        "requestedRisk": {
          "type": "string",
          "enum": ["R0", "R1", "R2", "R3", "R4"]
        },
        "sideEffect": {
          "type": "string",
          "enum": ["read", "write", "destructive", "external", "unknown"]
        },
        "network": { "type": "boolean" },
        "resultSchema": {}
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "description", "argumentsSchema", "headless"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "aliases": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "description": { "type": "string", "minLength": 1 },
        "argumentsSchema": {},
        "headless": { "type": "boolean" }
      }
    },
    "contextProvider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "drawers": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "title", "dataSource"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "title": { "type": "string", "minLength": 1 },
              "dataSource": { "type": "string", "minLength": 1 }
            }
          }
        },
        "statusItems": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "label", "eventKinds"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "eventKinds": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "events": { "type": "array", "items": { "type": "string" } },
        "tools": { "type": "array", "items": { "type": "string" } },
        "workspaceRead": { "type": "array", "items": { "type": "string" } },
        "workspaceWrite": { "type": "array", "items": { "type": "string" } },
        "networkDomains": { "type": "array", "items": { "type": "string" } },
        "credentials": { "type": "array", "items": { "type": "string" } },
        "artifacts": {
          "type": "string",
          "enum": ["none", "read-own", "create"]
        },
        "sessionState": {
          "type": "string",
          "enum": ["none", "read", "write-own"]
        },
        "memory": {
          "type": "string",
          "enum": ["none", "search", "propose"]
        },
        "graph": {
          "type": "string",
          "enum": ["none", "observe", "propose-node"]
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beforeHookMs": { "type": "integer", "minimum": 0 },
        "afterHookMs": { "type": "integer", "minimum": 0 },
        "maxOutputBytes": { "type": "integer", "minimum": 0 },
        "maxStateBytes": { "type": "integer", "minimum": 0 }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["files", "packageDigest"],
      "properties": {
        "files": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        },
        "packageDigest": { "type": "string", "minLength": 1 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["keyId", "algorithm", "signature"],
      "properties": {
        "keyId": { "type": "string", "minLength": 1 },
        "algorithm": { "type": "string", "minLength": 1 },
        "signature": { "type": "string", "minLength": 1 }
      }
    }
  }
}
