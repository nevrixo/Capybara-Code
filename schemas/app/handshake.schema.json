{
  "x-dialect": "json-schema-draft-2020-12",
  "$id": "cbc:app/handshake",
  "title": "App Protocol handshake",
  "description": "server.initialize params and result. Matches packages/app-protocol/src/handshake.ts.",
  "type": "object",
  "$defs": {
    "clientKind": {
      "type": "string",
      "enum": ["tui", "cli", "ide", "sdk", "ci", "plugin-host"]
    },
    "clientCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eventStreaming",
        "eventAck",
        "approvals",
        "interactivePrompts",
        "artifactStreaming",
        "richDiff"
      ],
      "properties": {
        "eventStreaming": { "type": "boolean" },
        "eventAck": { "type": "boolean" },
        "approvals": { "type": "boolean" },
        "interactivePrompts": { "type": "boolean" },
        "artifactStreaming": { "type": "boolean" },
        "richDiff": { "type": "boolean" },
        "taskTree": { "type": "boolean" },
        "planReview": { "type": "boolean" }
      }
    },
    "initializeParams": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocolVersion", "client", "capabilities"],
      "properties": {
        "protocolVersion": { "type": "string", "minLength": 1 },
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "name", "version", "kind"],
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "name": { "type": "string", "minLength": 1 },
            "version": { "type": "string", "minLength": 1 },
            "kind": { "$ref": "#/$defs/clientKind" }
          }
        },
        "capabilities": { "$ref": "#/$defs/clientCapabilities" },
        "authentication": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "challengeResponse": { "type": "string" }
          }
        }
      }
    },
    "serverLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRequestBytes",
        "maxResponseBytes",
        "maxSubscriptionsPerClient",
        "maxSessionsPerSubscription"
      ],
      "properties": {
        "maxRequestBytes": { "type": "integer", "minimum": 1 },
        "maxResponseBytes": { "type": "integer", "minimum": 1 },
        "maxSubscriptionsPerClient": { "type": "integer", "minimum": 1 },
        "maxSessionsPerSubscription": { "type": "integer", "minimum": 1 }
      }
    },
    "initializeResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "serverVersion",
        "daemonId",
        "connectionId",
        "capabilities",
        "capabilitySnapshot",
        "limits"
      ],
      "properties": {
        "protocolVersion": { "type": "string", "minLength": 1 },
        "serverVersion": { "type": "string", "minLength": 1 },
        "daemonId": { "type": "string", "minLength": 1 },
        "connectionId": { "type": "string", "minLength": 1 },
        "capabilities": {
          "type": "object",
          "additionalProperties": {
            "type": ["boolean", "string", "number"]
          }
        },
        "capabilitySnapshot": {
          "$ref": "cbc:integration/client-capabilities"
        },
        "limits": { "$ref": "#/$defs/serverLimits" }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/initializeParams" },
    { "$ref": "#/$defs/initializeResult" }
  ]
}
