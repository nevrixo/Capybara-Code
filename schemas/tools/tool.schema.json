{
  "x-dialect": "json-schema-draft-2020-12",
  "$id": "cbc:tools/tool",
  "title": "Capybara Code tool contract",
  "description": "PRD 12.2, 12.4, 13.2. Describes a tool definition, the common result envelope, and the P0 native catalog. 12.4's schema rules are asserted structurally here: a tool's own parameter schema must be strict, must reject unknown keys, and a mutation tool must carry either an expected hash or an explicit create policy.",
  "type": "object",
  "$defs": {
    "riskClass": {
      "description": "13.2. R4 through R6 may never receive a session-wide or project-wide allow rule.",
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3",
        "R4",
        "R5",
        "R6"
      ]
    },
    "toolSource": {
      "type": "string",
      "enum": [
        "native",
        "skill",
        "mcp"
      ]
    },
    "toolDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "description",
        "source",
        "defaultRisk",
        "maxRisk",
        "parameters",
        "alwaysActive",
        "mutates",
        "network",
        "keywords"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "$ref": "#/$defs/toolSource"
        },
        "defaultRisk": {
          "$ref": "#/$defs/riskClass"
        },
        "maxRisk": {
          "description": "The highest risk this tool can reach once arguments are considered. The classifier may promote up to this, never above it.",
          "$ref": "#/$defs/riskClass"
        },
        "parameters": {
          "$ref": "#/$defs/strictParameterSchema"
        },
        "alwaysActive": {
          "description": "6.9: an always-active tool is offered without discovery and is excluded from the activation budget.",
          "type": "boolean"
        },
        "mutates": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "strictParameterSchema": {
      "description": "12.4: a tool's argument schema is a strict object that rejects unknown keys, so a hallucinated argument fails validation instead of being silently dropped.",
      "type": "object",
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object"
        },
        "required": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "additionalProperties": {
          "const": false
        }
      }
    },
    "artifactRef": {
      "description": "18.17. A handle, never inline content. redaction records what was done to the bytes before they were stored.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "digest",
        "mediaType",
        "bytes",
        "redaction",
        "retentionClass"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": "string",
          "minLength": 1
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "redaction": {
          "type": "string",
          "enum": [
            "raw",
            "redacted",
            "derived"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "retentionClass": {
          "type": "string",
          "enum": [
            "session",
            "temporary",
            "pinned"
          ]
        }
      }
    },
    "toolResult": {
      "description": "12.4's common result envelope. summary is always present so an observation can be rendered even when data is absent.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "summary"
      ],
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "summary": {
          "type": "string"
        },
        "artifacts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/artifactRef"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message",
            "retryable"
          ],
          "properties": {
            "code": {
              "$ref": "cbc:protocol/rpc#/$defs/toolErrorCode"
            },
            "message": {
              "type": "string"
            },
            "retryable": {
              "description": "10.13: a timeout may be retried; a validation or permission failure may not, because the model must observe it and choose differently.",
              "type": "boolean"
            },
            "details": {
              "type": "object"
            }
          }
        },
        "data": true
      }
    },
    "nativeToolId": {
      "description": "12.2's P0 catalog, in declaration order.",
      "type": "string",
      "enum": [
        "fs.read",
        "fs.read_many",
        "fs.list",
        "fs.glob",
        "fs.search",
        "lsp.diagnostics",
        "lsp.symbols",
        "lsp.workspace_symbols",
        "lsp.definition",
        "lsp.declaration",
        "lsp.type_definition",
        "lsp.implementation",
        "lsp.references",
        "lsp.hover",
        "lsp.signature_help",
        "lsp.document_highlights",
        "lsp.call_hierarchy",
        "lsp.code_actions",
        "lsp.code_action_preview",
        "lsp.format_preview",
        "lsp.range_format_preview",
        "lsp.rename_preview",
        "memory.search",
        "memory.remember",
        "fs.apply_patch",
        "fs.edit.preview",
        "fs.edit",
        "fs.write",
        "fs.move",
        "fs.delete",
        "process.run",
        "process.start",
        "process.input",
        "process.stop",
        "shell.run",
        "artifact.read",
        "git.status",
        "git.diff",
        "git.log",
        "git.show",
        "git.checkpoint",
        "worktree.list",
        "worktree.inspect",
        "worktree.create",
        "worktree.remove",
        "merge.preview",
        "merge.apply",
        "merge.resolve",
        "user.ask",
        "task.search",
        "task.spawn",
        "task.status",
        "task.cancel",
        "plugin.invoke",
        "skill.search",
        "skill.load",
        "mcp.search",
        "mcp.call",
        "mcp.read_resource",
        "todo.write",
        "tool.discover",
        "repo.investigate",
        "verification.run_many"
      ]
    }
  },
  "oneOf": [
    {
      "$ref": "#/$defs/toolDefinition"
    },
    {
      "$ref": "#/$defs/toolResult"
    }
  ]
}
