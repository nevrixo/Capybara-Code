{
  "x-dialect": "json-schema-draft-2020-12",
  "$id": "cbc:edit/plan",
  "title": "EditPlan",
  "description": "Canonical anchor and range edit plan. Matches packages/edit-domain/src/types.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "source",
    "workspaceIdentityDigest",
    "sessionId",
    "operations",
    "conflictPolicy",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^edp_" },
    "source": {
      "type": "string",
      "enum": ["model", "lsp", "plugin", "merge", "user"]
    },
    "workspaceIdentityDigest": { "type": "string", "minLength": 1 },
    "worktreeId": { "type": "string", "minLength": 1 },
    "sessionId": { "type": "string", "minLength": 1 },
    "turnId": { "type": "string", "minLength": 1 },
    "agentId": { "type": "string", "minLength": 1 },
    "baseWorkspaceRevision": { "type": "string", "minLength": 1 },
    "operations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/editOperation" }
    },
    "conflictPolicy": {
      "type": "string",
      "enum": ["fail", "safe_rebase"]
    },
    "verificationHints": {
      "type": "array",
      "items": { "type": "string" }
    },
    "createdAt": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "textPosition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line", "column"],
      "properties": {
        "line": { "type": "integer", "minimum": 1 },
        "column": { "type": "integer", "minimum": 1 }
      }
    },
    "textRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "encoding"],
      "properties": {
        "start": { "$ref": "#/$defs/textPosition" },
        "end": { "$ref": "#/$defs/textPosition" },
        "encoding": {
          "type": "string",
          "enum": ["utf8", "utf16", "unicode_scalar"]
        }
      }
    },
    "exactTextAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "baseRevision", "originalText", "originalTextDigest"],
      "properties": {
        "kind": { "const": "exact_text" },
        "baseRevision": { "type": "string", "minLength": 1 },
        "originalText": { "type": "string" },
        "originalTextDigest": { "type": "string", "minLength": 1 },
        "occurrence": { "type": "integer", "minimum": 0 },
        "expectedRange": { "$ref": "#/$defs/textRange" }
      }
    },
    "contextAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "baseRevision", "targetDigest", "before", "after", "whitespacePolicy"],
      "properties": {
        "kind": { "const": "context" },
        "baseRevision": { "type": "string", "minLength": 1 },
        "targetDigest": { "type": "string", "minLength": 1 },
        "targetPreview": { "type": "string" },
        "before": { "type": "array", "items": { "type": "string" } },
        "after": { "type": "array", "items": { "type": "string" } },
        "approximateLine": { "type": "integer", "minimum": 1 },
        "symbolPath": { "type": "array", "items": { "type": "string" } },
        "whitespacePolicy": {
          "type": "string",
          "enum": ["exact", "normalize_eol", "normalize_indent"]
        }
      }
    },
    "symbolAnchor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "baseRevision", "languageId", "symbolPath"],
      "properties": {
        "kind": { "const": "symbol" },
        "baseRevision": { "type": "string", "minLength": 1 },
        "languageId": { "type": "string", "minLength": 1 },
        "symbolPath": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "symbolKind": { "type": "string" },
        "relativeRange": { "$ref": "#/$defs/textRange" },
        "symbolBodyDigest": { "type": "string" },
        "fallbackContext": { "$ref": "#/$defs/contextAnchor" }
      }
    },
    "editAnchor": {
      "oneOf": [
        { "$ref": "#/$defs/exactTextAnchor" },
        { "$ref": "#/$defs/contextAnchor" },
        { "$ref": "#/$defs/symbolAnchor" }
      ]
    },
    "replaceAnchorOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind", "anchor", "replacement"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "replace_anchor" },
        "anchor": { "$ref": "#/$defs/editAnchor" },
        "replacement": { "type": "string" }
      }
    },
    "replaceRangeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind", "baseRevision", "range", "replacement"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "replace_range" },
        "baseRevision": { "type": "string", "minLength": 1 },
        "range": { "$ref": "#/$defs/textRange" },
        "expectedTextDigest": { "type": "string" },
        "replacement": { "type": "string" }
      }
    },
    "insertBeforeOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind", "anchor", "text"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "insert_before" },
        "anchor": { "$ref": "#/$defs/editAnchor" },
        "text": { "type": "string" }
      }
    },
    "insertAfterOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind", "anchor", "text"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "insert_after" },
        "anchor": { "$ref": "#/$defs/editAnchor" },
        "text": { "type": "string" }
      }
    },
    "deleteAnchorOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind", "anchor"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "delete_anchor" },
        "anchor": { "$ref": "#/$defs/editAnchor" }
      }
    },
    "createFileOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind", "content"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "create_file" },
        "content": { "type": "string" }
      }
    },
    "moveFileOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind", "toPath"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "move_file" },
        "toPath": { "type": "string", "minLength": 1 },
        "expectedRevision": { "type": "string" }
      }
    },
    "deleteFileOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operationId", "path", "kind"],
      "properties": {
        "operationId": { "type": "string", "pattern": "^edo_" },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "const": "delete_file" },
        "expectedRevision": { "type": "string" }
      }
    },
    "editOperation": {
      "oneOf": [
        { "$ref": "#/$defs/replaceAnchorOperation" },
        { "$ref": "#/$defs/replaceRangeOperation" },
        { "$ref": "#/$defs/insertBeforeOperation" },
        { "$ref": "#/$defs/insertAfterOperation" },
        { "$ref": "#/$defs/deleteAnchorOperation" },
        { "$ref": "#/$defs/createFileOperation" },
        { "$ref": "#/$defs/moveFileOperation" },
        { "$ref": "#/$defs/deleteFileOperation" }
      ]
    }
  }
}
